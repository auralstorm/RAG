ENTERPRISE_RAG_APP_NAME=EnterpriseRag
ENTERPRISE_RAG_ENVIRONMENT=development
ENTERPRISE_RAG_CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:5174"]
# Local infrastructure credentials are generated by make infra-up in infra/compose/.env.development.
# Set process variable ENTERPRISE_RAG_INFRA_PROFILE=test to select the isolated test environment.
# S3-compatible object storage is RustFS; override generated values with these process variables:
# ENTERPRISE_RAG_OBJECT_STORAGE_ENDPOINT / ACCESS_KEY / SECRET_KEY / BUCKET
# Legacy ENTERPRISE_RAG_MINIO_* names remain accepted during configuration migration.
# Optional development-only identity source. Provision accounts first; never enable in production.
# ENTERPRISE_RAG_LOCAL_IDENTITY_CONFIG_REF=.poc-results/auth/local.json
# Platform session/policy keys also enable database-backed platform password login when no local test source is configured.
# Initialize a new owner-only file with uv run --locked python -m scripts.initialize_platform_auth.
# ENTERPRISE_RAG_AUTH_PLATFORM_CONFIG_REF=.poc-results/auth/platform.json
# Provider API Keys and proxy URLs are AES-GCM encrypted in PostgreSQL with this separate owner-only key file.
# Initialize it with uv run --locked python -m scripts.initialize_provider_secrets.
# ENTERPRISE_RAG_PROVIDER_SECRETS_CONFIG_REF=.poc-results/providers/secrets.json
# Technical JSON logs and SDK metrics use make dev-backend's controlled log configuration.
# Phoenix export requires an authorized service token in an owner-only reference file:
# ENTERPRISE_RAG_TELEMETRY_TRACE_EXPORT_ENABLED=true
# ENTERPRISE_RAG_TELEMETRY_CREDENTIALS_REF=.poc-results/observability/collector.json
# ENTERPRISE_RAG_TELEMETRY_OTLP_ENDPOINT=http://127.0.0.1:14317
# ENTERPRISE_RAG_TELEMETRY_INTERVAL_SECONDS=30
# ENTERPRISE_RAG_TELEMETRY_SAMPLE_RATIO=1
# Observe only already-created server-configured queues; leave empty until Worker setup.
# ENTERPRISE_RAG_TELEMETRY_QUEUES=[]
