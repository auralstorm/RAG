ENTERPRISE_RAG_APP_NAME=EnterpriseRag
ENTERPRISE_RAG_ENVIRONMENT=development
ENTERPRISE_RAG_CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:5174"]
# Local infrastructure credentials are generated by make infra-up in infra/compose/.env.development.
# Set process variable ENTERPRISE_RAG_INFRA_PROFILE=test to select the isolated test environment.
# S3-compatible object storage is RustFS; override generated values with these process variables:
# ENTERPRISE_RAG_OBJECT_STORAGE_ENDPOINT / ACCESS_KEY / SECRET_KEY / BUCKET
# Legacy ENTERPRISE_RAG_MINIO_* names remain accepted during configuration migration.
