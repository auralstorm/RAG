{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "description": "Public error summary; callers supply only explicitly safe details.",
        "properties": {
          "code": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Details",
            "type": "object"
          },
          "message": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ApiErrorEnvelope": {
        "additionalProperties": false,
        "description": "The V1 API's stable error response, independent of the failing implementation.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiErrorEnvelope",
        "type": "object"
      },
      "Application": {
        "enum": [
          "chat",
          "admin"
        ],
        "type": "string"
      },
      "AuthConfiguration": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "local",
              "unavailable"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "AuthConfiguration",
        "type": "object"
      },
      "AuthSessionResponse": {
        "additionalProperties": false,
        "properties": {
          "application": {
            "$ref": "#/components/schemas/Application"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "csrf_token",
          "user",
          "application",
          "expires_at"
        ],
        "title": "AuthSessionResponse",
        "type": "object"
      },
      "CsrfResponse": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfResponse",
        "type": "object"
      },
      "JsonValue": {},
      "LivenessResponse": {
        "additionalProperties": false,
        "description": "Process liveness does not claim that external dependencies are available.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginCredentials": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginCredentials",
        "type": "object"
      },
      "ReadinessReport": {
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "ReadinessReport",
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "description": "Canonical platform subject; status is current server state, not a token claim.",
        "properties": {
          "created_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "display_name": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "updated_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          }
        },
        "required": [
          "id",
          "display_name",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "User",
        "type": "object"
      },
      "UserStatus": {
        "enum": [
          "ACTIVE",
          "DISABLED",
          "LOCKED",
          "PENDING_DEPARTURE",
          "DEPARTED"
        ],
        "title": "UserStatus",
        "type": "string"
      },
      "UtcTimestamp": {
        "format": "date-time",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "EnterpriseRag",
    "version": "0.1.0"
  },
