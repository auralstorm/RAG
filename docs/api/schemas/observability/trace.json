{
  "$defs": {
    "ConfigurationVersion": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "DocumentVersionRef": {
      "additionalProperties": false,
      "description": "Stable version entity ID plus the numeric version used by retrieval projections.",
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "minimum": 1,
          "title": "Document Version",
          "type": "integer"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "document_id",
        "kb_id",
        "document_version"
      ],
      "title": "DocumentVersionRef",
      "type": "object"
    },
    "ModelCost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "REPORTED",
            "ESTIMATED"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency",
        "source"
      ],
      "title": "ModelCost",
      "type": "object"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCost"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/UsageSource"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Tokens"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "source"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "SpanId": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "TraceError": {
      "enum": [
        "TIMEOUT",
        "ACCESS_DENIED",
        "INSUFFICIENT_EVIDENCE",
        "INVALID_CITATION",
        "DEPENDENCY_UNAVAILABLE",
        "INTERNAL_ERROR"
      ],
      "title": "TraceError",
      "type": "string"
    },
    "TraceId": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "TraceSpan": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Count"
        },
        "document_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentVersionRef"
          },
          "maxItems": 100,
          "title": "Document Versions",
          "type": "array"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_config_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigurationVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpanId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigurationVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "span_id": {
          "$ref": "#/$defs/SpanId"
        },
        "stage": {
          "$ref": "#/$defs/TraceStage"
        },
        "started_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "status": {
          "$ref": "#/$defs/TraceStatus"
        },
        "token_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "span_id",
        "stage",
        "status",
        "started_at"
      ],
      "title": "TraceSpan",
      "type": "object"
    },
    "TraceStage": {
      "enum": [
        "rag.answer",
        "auth.policy",
        "query.route",
        "conversation.load",
        "query.rewrite",
        "embedding.query",
        "retrieval.dense",
        "retrieval.bm25",
        "retrieval.fusion",
        "retrieval.rerank",
        "context.assemble",
        "llm.generate",
        "citation.validate",
        "response.stream"
      ],
      "title": "TraceStage",
      "type": "string"
    },
    "TraceStatus": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "REFUSED"
      ],
      "title": "TraceStatus",
      "type": "string"
    },
    "UsageSource": {
      "enum": [
        "REPORTED",
        "ESTIMATED",
        "UNAVAILABLE"
      ],
      "title": "UsageSource",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_version": {
      "$ref": "#/$defs/ConfigurationVersion"
    },
    "index_version_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Index Version Ids",
      "type": "array"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/TraceSpan"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Spans",
      "type": "array"
    },
    "trace_id": {
      "$ref": "#/$defs/TraceId"
    }
  },
  "required": [
    "trace_id",
    "request_id",
    "config_version",
    "spans"
  ],
  "title": "Trace",
  "type": "object"
}
