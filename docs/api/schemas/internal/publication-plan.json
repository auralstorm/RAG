{
  "$defs": {
    "ConfigurationVersion": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "ContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EmbeddingBinding": {
      "additionalProperties": false,
      "description": "Exact model/configuration/vector-space identity; dimensions have no inferred default.",
      "properties": {
        "config_version": {
          "$ref": "#/$defs/ConfigurationVersion"
        },
        "dimensions": {
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "embedding_model_id": {
          "format": "uuid",
          "title": "Embedding Model Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "embedding_model_id",
        "config_version",
        "dimensions"
      ],
      "title": "EmbeddingBinding",
      "type": "object"
    },
    "IndexName": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "PublicationAction": {
      "enum": [
        "PUBLISH",
        "ROLLBACK"
      ],
      "title": "PublicationAction",
      "type": "string"
    },
    "PublicationRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/PublicationAction"
        },
        "expected_active_index_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Active Index Version Id"
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Idempotency Key",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_index_version_id": {
          "format": "uuid",
          "title": "Target Index Version Id",
          "type": "string"
        }
      },
      "required": [
        "kb_id",
        "action",
        "target_index_version_id",
        "expected_active_index_version_id",
        "idempotency_key"
      ],
      "title": "PublicationRequest",
      "type": "object"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Validated CAS and alias intent; constructing it performs no publication or IO.",
  "properties": {
    "actor_subject_id": {
      "format": "uuid",
      "title": "Actor Subject Id",
      "type": "string"
    },
    "add_physical_index": {
      "$ref": "#/$defs/IndexName"
    },
    "alias_name": {
      "$ref": "#/$defs/IndexName"
    },
    "embedding": {
      "$ref": "#/$defs/EmbeddingBinding"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/ContentHash"
    },
    "prepared_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "remove_physical_index": {
      "anyOf": [
        {
          "$ref": "#/$defs/IndexName"
        },
        {
          "type": "null"
        }
      ]
    },
    "request": {
      "$ref": "#/$defs/PublicationRequest"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request",
    "actor_subject_id",
    "alias_name",
    "remove_physical_index",
    "add_physical_index",
    "embedding",
    "manifest_sha256",
    "prepared_at"
  ],
  "title": "PublicationPlan",
  "type": "object"
}
