{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Rectangular normalized cell text; unsupported structural loss needs a parser warning.",
  "properties": {
    "rows": {
      "items": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "rows"
  ],
  "title": "ParsedTable",
  "type": "object"
}
