{
  "$defs": {
    "TraceId": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "protected_identity_ref": {
      "format": "uuid",
      "title": "Protected Identity Ref",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "$ref": "#/$defs/TraceId"
    }
  },
  "required": [
    "trace_id",
    "request_id",
    "protected_identity_ref",
    "expires_at"
  ],
  "title": "TraceIdentityLink",
  "type": "object"
}
