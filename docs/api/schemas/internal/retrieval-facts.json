{
  "$defs": {
    "AccessPurpose": {
      "enum": [
        "admin",
        "chat"
      ],
      "title": "AccessPurpose",
      "type": "string"
    },
    "ActorReference": {
      "pattern": "^actor_[0-9a-f]{64}$",
      "type": "string"
    },
    "AuthorizationSnapshot": {
      "additionalProperties": false,
      "description": "Current facts independently loaded by the trusted server, not copied from context.\n\nSnapshot validity is an input guard, not proof that a cached grant survived revocation.\nProducers reload current identity/roles/groups/ACL for every authorization operation.",
      "properties": {
        "actor_ref": {
          "$ref": "#/$defs/ActorReference"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "expires_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "group_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Group Ids",
          "type": "array",
          "uniqueItems": true
        },
        "identity": {
          "$ref": "#/$defs/ExternalIdentity"
        },
        "observed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "permission_codes": {
          "items": {
            "$ref": "#/$defs/PermissionCode"
          },
          "title": "Permission Codes",
          "type": "array",
          "uniqueItems": true
        },
        "policy_version": {
          "$ref": "#/$defs/PolicyVersion"
        },
        "purpose": {
          "$ref": "#/$defs/AccessPurpose"
        },
        "resource_grants": {
          "items": {
            "$ref": "#/$defs/ResourceGrant"
          },
          "title": "Resource Grants",
          "type": "array"
        },
        "role_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Role Ids",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_bindings": {
          "items": {
            "$ref": "#/$defs/SubjectBinding"
          },
          "title": "Subject Bindings",
          "type": "array"
        },
        "user": {
          "$ref": "#/$defs/User"
        }
      },
      "required": [
        "user",
        "identity",
        "actor_ref",
        "environment",
        "purpose",
        "policy_version",
        "role_ids",
        "group_ids",
        "permission_codes",
        "resource_grants",
        "subject_bindings",
        "observed_at",
        "expires_at"
      ],
      "title": "AuthorizationSnapshot",
      "type": "object"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Normalized [0,1] coordinates, origin at the page's top-left, in displayed orientation.",
      "properties": {
        "bottom": {
          "maximum": 1,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "maximum": 1,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "maximum": 1,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "top": {
          "maximum": 1,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "chunk_index": {
          "minimum": 0,
          "title": "Chunk Index",
          "type": "integer"
        },
        "chunking_config_version": {
          "$ref": "#/$defs/ConfigurationVersion"
        },
        "content": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Content",
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "minimum": 1,
          "title": "Document Version",
          "type": "integer"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ChunkMetadata"
        },
        "parent_chunk_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Chunk Id"
        },
        "role": {
          "$ref": "#/$defs/ChunkRole"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ChunkSource"
        },
        "token_count": {
          "exclusiveMinimum": 0,
          "title": "Token Count",
          "type": "integer"
        },
        "tokenizer_version": {
          "$ref": "#/$defs/ConfigurationVersion"
        }
      },
      "required": [
        "document_version_id",
        "document_id",
        "kb_id",
        "document_version",
        "id",
        "chunk_index",
        "role",
        "parent_chunk_id",
        "content",
        "content_hash",
        "token_count",
        "tokenizer_version",
        "chunking_config_version",
        "source",
        "metadata",
        "created_at"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "ChunkMetadata": {
      "additionalProperties": false,
      "properties": {
        "heading_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "ChunkMetadata",
      "type": "object"
    },
    "ChunkRole": {
      "enum": [
        "STANDALONE",
        "PARENT",
        "CHILD"
      ],
      "title": "ChunkRole",
      "type": "string"
    },
    "ChunkSource": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/ChunkSourceSpan"
          },
          "minItems": 1,
          "title": "Spans",
          "type": "array"
        }
      },
      "required": [
        "spans"
      ],
      "title": "ChunkSource",
      "type": "object"
    },
    "ChunkSourceSpan": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Block Id",
          "type": "string"
        },
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "char_start",
        "char_end",
        "location"
      ],
      "title": "ChunkSourceSpan",
      "type": "object"
    },
    "ConfigurationVersion": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "ContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Document": {
      "additionalProperties": false,
      "description": "Logical resource; a newer failed processing version does not unpublish older content.",
      "properties": {
        "acl_policy_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acl Policy Id"
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "current_version": {
          "minimum": 1,
          "title": "Current Version",
          "type": "integer"
        },
        "deleted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/DocumentSourceType"
        },
        "status": {
          "$ref": "#/$defs/DocumentStatus"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "kb_id",
        "title",
        "source_type",
        "current_version",
        "status",
        "acl_policy_id",
        "created_by",
        "created_at",
        "updated_at"
      ],
      "title": "Document",
      "type": "object"
    },
    "DocumentAccessPolicy": {
      "additionalProperties": false,
      "description": "Current document restriction intersects KB permission; None explicitly means inherit.",
      "properties": {
        "acl_policy_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acl Policy Id"
        },
        "allowed_subject_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "title": "Allowed Subject Ids"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "policy_version": {
          "$ref": "#/$defs/PolicyVersion"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "kb_id",
        "acl_policy_id",
        "allowed_subject_ids",
        "policy_version"
      ],
      "title": "DocumentAccessPolicy",
      "type": "object"
    },
    "DocumentMimeType": {
      "enum": [
        "text/markdown",
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ],
      "type": "string"
    },
    "DocumentSourceType": {
      "enum": [
        "UPLOAD",
        "CONNECTOR"
      ],
      "title": "DocumentSourceType",
      "type": "string"
    },
    "DocumentStatus": {
      "enum": [
        "ACTIVE",
        "DELETING",
        "DELETED"
      ],
      "title": "DocumentStatus",
      "type": "string"
    },
    "DocumentVersion": {
      "additionalProperties": false,
      "description": "Public version facts exclude private keys, source URLs and parser-specific payloads.",
      "properties": {
        "chunking_config_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigurationVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "minimum": 1,
          "title": "Document Version",
          "type": "integer"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "file_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "file_size": {
          "exclusiveMinimum": 0,
          "title": "File Size",
          "type": "integer"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "mime_type": {
          "$ref": "#/$defs/DocumentMimeType"
        },
        "parser_name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Name"
        },
        "parser_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigurationVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pipeline_version": {
          "$ref": "#/$defs/ConfigurationVersion"
        },
        "published_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DocumentVersionStatus"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "document_version_id",
        "document_id",
        "kb_id",
        "document_version",
        "status",
        "mime_type",
        "file_size",
        "file_hash",
        "pipeline_version",
        "created_at",
        "updated_at"
      ],
      "title": "DocumentVersion",
      "type": "object"
    },
    "DocumentVersionRef": {
      "additionalProperties": false,
      "description": "Stable version entity ID plus the numeric version used by retrieval projections.",
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "minimum": 1,
          "title": "Document Version",
          "type": "integer"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "document_id",
        "kb_id",
        "document_version"
      ],
      "title": "DocumentVersionRef",
      "type": "object"
    },
    "DocumentVersionStatus": {
      "enum": [
        "UPLOADED",
        "PARSING",
        "PARSED",
        "CHUNKING",
        "EMBEDDING",
        "INDEXING",
        "INDEXED",
        "PUBLISHED",
        "FAILED",
        "DELETING",
        "DELETED"
      ],
      "title": "DocumentVersionStatus",
      "type": "string"
    },
    "DocxSourceLocation": {
      "additionalProperties": false,
      "description": "Zero-based body element index, counting paragraphs and tables in original order.",
      "properties": {
        "element_index": {
          "minimum": 0,
          "title": "Element Index",
          "type": "integer"
        },
        "element_type": {
          "enum": [
            "paragraph",
            "table"
          ],
          "title": "Element Type",
          "type": "string"
        },
        "kind": {
          "const": "docx",
          "default": "docx",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "element_index",
        "element_type"
      ],
      "title": "DocxSourceLocation",
      "type": "object"
    },
    "EmbeddingBinding": {
      "additionalProperties": false,
      "description": "Exact model/configuration/vector-space identity; dimensions have no inferred default.",
      "properties": {
        "config_version": {
          "$ref": "#/$defs/ConfigurationVersion"
        },
        "dimensions": {
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "embedding_model_id": {
          "format": "uuid",
          "title": "Embedding Model Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "embedding_model_id",
        "config_version",
        "dimensions"
      ],
      "title": "EmbeddingBinding",
      "type": "object"
    },
    "Environment": {
      "enum": [
        "development",
        "test",
        "production"
      ],
      "type": "string"
    },
    "ExternalIdentity": {
      "additionalProperties": false,
      "description": "Restricted mapping facts; raw issuer/subject never belong in public User or Trace DTOs.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "issuer": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Issuer",
          "type": "string"
        },
        "provider_key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Provider Key",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/IdentityStatus"
        },
        "subject": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Subject",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "provider_key",
        "issuer",
        "subject",
        "id",
        "user_id",
        "status"
      ],
      "title": "ExternalIdentity",
      "type": "object"
    },
    "IdentityStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "IdentityStatus",
      "type": "string"
    },
    "IndexAlias": {
      "additionalProperties": false,
      "description": "Freshly observed internal alias state; both pointers must represent the same target.",
      "properties": {
        "active_index_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Index Version Id"
        },
        "alias_name": {
          "$ref": "#/$defs/IndexName"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "physical_index_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndexName"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kb_id",
        "alias_name",
        "active_index_version_id",
        "physical_index_name"
      ],
      "title": "IndexAlias",
      "type": "object"
    },
    "IndexManifest": {
      "additionalProperties": false,
      "description": "Internal authoritative member list; at most one version per logical document.",
      "properties": {
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentVersionRef"
          },
          "title": "Documents",
          "type": "array"
        },
        "index_version_id": {
          "format": "uuid",
          "title": "Index Version Id",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "index_version_id",
        "kb_id",
        "documents"
      ],
      "title": "IndexManifest",
      "type": "object"
    },
    "IndexName": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "IndexValidationReport": {
      "additionalProperties": false,
      "description": "Trusted validation facts; every required check is explicit, including the quality gate.",
      "properties": {
        "acl_verified": {
          "title": "Acl Verified",
          "type": "boolean"
        },
        "actual_chunk_count": {
          "minimum": 0,
          "title": "Actual Chunk Count",
          "type": "integer"
        },
        "actual_document_count": {
          "minimum": 0,
          "title": "Actual Document Count",
          "type": "integer"
        },
        "binding_sha256": {
          "$ref": "#/$defs/ContentHash"
        },
        "checked_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "expected_chunk_count": {
          "minimum": 0,
          "title": "Expected Chunk Count",
          "type": "integer"
        },
        "expected_document_count": {
          "minimum": 0,
          "title": "Expected Document Count",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "index_version_id": {
          "format": "uuid",
          "title": "Index Version Id",
          "type": "string"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/ContentHash"
        },
        "mapping_verified": {
          "title": "Mapping Verified",
          "type": "boolean"
        },
        "quality_gate_verified": {
          "title": "Quality Gate Verified",
          "type": "boolean"
        },
        "retrieval_verified": {
          "title": "Retrieval Verified",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ValidationVerdict"
        }
      },
      "required": [
        "id",
        "index_version_id",
        "manifest_sha256",
        "binding_sha256",
        "verdict",
        "expected_document_count",
        "actual_document_count",
        "expected_chunk_count",
        "actual_chunk_count",
        "mapping_verified",
        "acl_verified",
        "retrieval_verified",
        "quality_gate_verified",
        "checked_at"
