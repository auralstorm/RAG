      "type": "string"
    },
    "MarkdownSourceLocation": {
      "additionalProperties": false,
      "description": "Half-open Unicode code-point offsets in the original decoded Markdown source.",
      "properties": {
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "kind": {
          "const": "markdown",
          "default": "markdown",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "char_start",
        "char_end"
      ],
      "title": "MarkdownSourceLocation",
      "type": "object"
    },
    "PdfSourceLocation": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
