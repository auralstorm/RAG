          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/DocumentVersion"
        }
      },
      "required": [
        "kb",
        "document",
        "version",
        "index",
        "alias",
        "manifest"
      ],
      "title": "PublishedDocumentSnapshot",
      "type": "object"
    },
