      "title": "IndexValidationReport",
      "type": "object"
    },
    "IndexVersionStatus": {
      "enum": [
        "BUILDING",
        "VALIDATING",
        "READY",
        "ACTIVE",
        "ROLLED_BACK",
        "FAILED",
        "RETIRED"
      ],
      "title": "IndexVersionStatus",
      "type": "string"
    },
    "KnowledgeBase": {
      "additionalProperties": false,
      "description": "Logical KB metadata; query embedding always uses its active index's pinned binding.",
      "properties": {
        "active_index_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Index Version Id"
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "deleted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "embedding": {
          "$ref": "#/$defs/EmbeddingBinding"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/KnowledgeBaseStatus"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "embedding",
        "active_index_version_id",
        "created_by",
        "created_at",
        "updated_at"
      ],
      "title": "KnowledgeBase",
      "type": "object"
    },
    "KnowledgeBaseStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED",
        "DELETING",
        "DELETED"
      ],
      "title": "KnowledgeBaseStatus",
      "type": "string"
    },
    "KnowledgePermission": {
      "enum": [
        "READ",
        "MANAGE"
      ],
