{
  "$defs": {
    "Environment": {
      "enum": [
        "development",
        "test",
        "production"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Opaque versioned reference; validation neither resolves nor grants secret access.",
  "properties": {
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_id": {
      "format": "uuid",
      "title": "Secret Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "secret_id",
    "version",
    "environment"
  ],
  "title": "SecretReference",
  "type": "object"
}
