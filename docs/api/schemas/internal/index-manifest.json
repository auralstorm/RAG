{
  "$defs": {
    "DocumentVersionRef": {
      "additionalProperties": false,
      "description": "Stable version entity ID plus the numeric version used by retrieval projections.",
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "minimum": 1,
          "title": "Document Version",
          "type": "integer"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "document_id",
        "kb_id",
        "document_version"
      ],
      "title": "DocumentVersionRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Internal authoritative member list; at most one version per logical document.",
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/DocumentVersionRef"
      },
      "title": "Documents",
      "type": "array"
    },
    "index_version_id": {
      "format": "uuid",
      "title": "Index Version Id",
      "type": "string"
    },
    "kb_id": {
      "format": "uuid",
      "title": "Kb Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "index_version_id",
    "kb_id",
    "documents"
  ],
  "title": "IndexManifest",
  "type": "object"
}
