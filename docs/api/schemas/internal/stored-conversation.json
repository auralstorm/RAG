        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "owner_subject_id": {
      "format": "uuid",
      "title": "Owner Subject Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "conversation",
    "owner_subject_id"
  ],
  "title": "StoredConversation",
  "type": "object"
