          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "title",
        "created_at",
        "updated_at"
      ],
      "title": "Conversation",
      "type": "object"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conversation": {
      "$ref": "#/$defs/Conversation"
    },
    "deleted_at": {
