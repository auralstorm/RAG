{
  "$defs": {
    "AccessPurpose": {
      "enum": [
        "admin",
        "chat"
      ],
      "title": "AccessPurpose",
      "type": "string"
    },
    "ActorReference": {
      "pattern": "^actor_[0-9a-f]{64}$",
      "type": "string"
    },
    "Environment": {
      "enum": [
        "development",
        "test",
        "production"
      ],
      "type": "string"
    },
    "ExternalIdentity": {
      "additionalProperties": false,
      "description": "Restricted mapping facts; raw issuer/subject never belong in public User or Trace DTOs.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "issuer": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Issuer",
          "type": "string"
        },
        "provider_key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Provider Key",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/IdentityStatus"
        },
        "subject": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Subject",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "provider_key",
        "issuer",
        "subject",
        "id",
        "user_id",
        "status"
      ],
      "title": "ExternalIdentity",
      "type": "object"
    },
    "IdentityStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "IdentityStatus",
      "type": "string"
    },
    "KnowledgePermission": {
      "enum": [
        "READ",
        "MANAGE"
      ],
      "title": "KnowledgePermission",
      "type": "string"
    },
    "LegacyPrincipalType": {
      "enum": [
        "ADMIN_USER",
        "EMPLOYEE"
      ],
      "title": "LegacyPrincipalType",
      "type": "string"
    },
    "PermissionCode": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "PolicyVersion": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    },
    "ResourceGrant": {
      "additionalProperties": false,
      "description": "Explicit KB capability; source profile types require a verified SubjectBinding.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kb_id": {
          "format": "uuid",
          "title": "Kb Id",
          "type": "string"
        },
        "permission": {
          "$ref": "#/$defs/KnowledgePermission"
        },
        "principal_id": {
          "format": "uuid",
          "title": "Principal Id",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/ResourcePrincipalType"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kb_id",
        "principal_type",
        "principal_id",
        "permission"
      ],
      "title": "ResourceGrant",
      "type": "object"
    },
    "ResourcePrincipalType": {
      "enum": [
        "USER",
        "ROLE",
        "GROUP",
        "ADMIN_USER",
        "EMPLOYEE"
      ],
      "title": "ResourcePrincipalType",
      "type": "string"
    },
    "SubjectBinding": {
      "additionalProperties": false,
      "description": "Explicit source-profile to canonical-User association, loaded by the trusted server.",
      "properties": {
        "principal_id": {
          "format": "uuid",
          "title": "Principal Id",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/LegacyPrincipalType"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "principal_type",
        "principal_id",
        "user_id"
      ],
      "title": "SubjectBinding",
      "type": "object"
    },
    "User": {
      "additionalProperties": false,
      "description": "Canonical platform subject; status is current server state, not a token claim.",
      "properties": {
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/UserStatus"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "display_name",
        "status",
        "created_at",
        "updated_at"
      ],
      "title": "User",
      "type": "object"
    },
    "UserStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED",
        "LOCKED",
        "PENDING_DEPARTURE",
        "DEPARTED"
      ],
      "title": "UserStatus",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Current facts independently loaded by the trusted server, not copied from context.\n\nSnapshot validity is an input guard, not proof that a cached grant survived revocation.\nProducers reload current identity/roles/groups/ACL for every authorization operation.",
  "properties": {
    "actor_ref": {
      "$ref": "#/$defs/ActorReference"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "expires_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "group_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Group Ids",
      "type": "array",
      "uniqueItems": true
    },
    "identity": {
      "$ref": "#/$defs/ExternalIdentity"
    },
    "observed_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "permission_codes": {
      "items": {
        "$ref": "#/$defs/PermissionCode"
      },
      "title": "Permission Codes",
      "type": "array",
      "uniqueItems": true
    },
    "policy_version": {
      "$ref": "#/$defs/PolicyVersion"
    },
    "purpose": {
      "$ref": "#/$defs/AccessPurpose"
    },
    "resource_grants": {
      "items": {
        "$ref": "#/$defs/ResourceGrant"
      },
      "title": "Resource Grants",
      "type": "array"
    },
    "role_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Role Ids",
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_bindings": {
      "items": {
        "$ref": "#/$defs/SubjectBinding"
      },
      "title": "Subject Bindings",
      "type": "array"
    },
    "user": {
      "$ref": "#/$defs/User"
    }
  },
  "required": [
    "user",
    "identity",
    "actor_ref",
    "environment",
    "purpose",
    "policy_version",
    "role_ids",
    "group_ids",
    "permission_codes",
    "resource_grants",
    "subject_bindings",
    "observed_at",
    "expires_at"
  ],
  "title": "AuthorizationSnapshot",
  "type": "object"
}
