{
  "$defs": {
    "IdentityStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "IdentityStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Restricted mapping facts; raw issuer/subject never belong in public User or Trace DTOs.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "issuer": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Issuer",
      "type": "string"
    },
    "provider_key": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Provider Key",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/IdentityStatus"
    },
    "subject": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Subject",
      "type": "string"
    },
    "user_id": {
      "format": "uuid",
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "provider_key",
    "issuer",
    "subject",
    "id",
    "user_id",
    "status"
  ],
  "title": "ExternalIdentity",
  "type": "object"
}
