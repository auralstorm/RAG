{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Role metadata does not grant permissions; assignments and grants are separate facts.",
  "else": {
    "properties": {
      "is_system": {
        "const": false
      }
    }
  },
  "if": {
    "properties": {
      "code": {
        "enum": [
          "SUPER_ADMIN",
          "KB_ADMIN",
          "AUDIT_READONLY"
        ]
      }
    },
    "required": [
      "code"
    ]
  },
  "properties": {
    "code": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Code",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "is_system": {
      "title": "Is System",
      "type": "boolean"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "protected": {
      "title": "Protected",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "code",
    "name",
    "is_system",
    "protected"
  ],
  "then": {
    "properties": {
      "is_system": {
        "const": true
      },
      "protected": {
        "const": true
      }
    }
  },
  "title": "Role",
  "type": "object"
}
