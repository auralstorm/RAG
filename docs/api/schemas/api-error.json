{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "description": "Public error summary; callers supply only explicitly safe details.",
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "request_id",
        "retryable"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "The V1 API's stable error response, independent of the failing implementation.",
  "properties": {
    "error": {
      "$ref": "#/$defs/ApiError"
    }
  },
  "required": [
    "error"
  ],
  "title": "ApiErrorEnvelope",
  "type": "object"
}
