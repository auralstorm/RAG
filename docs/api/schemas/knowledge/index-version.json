{
  "$defs": {
    "ConfigurationVersion": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "ContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EmbeddingBinding": {
      "additionalProperties": false,
      "description": "Exact model/configuration/vector-space identity; dimensions have no inferred default.",
      "properties": {
        "config_version": {
          "$ref": "#/$defs/ConfigurationVersion"
        },
        "dimensions": {
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "embedding_model_id": {
          "format": "uuid",
          "title": "Embedding Model Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "embedding_model_id",
        "config_version",
        "dimensions"
      ],
      "title": "EmbeddingBinding",
      "type": "object"
    },
    "IndexVersionStatus": {
      "enum": [
        "BUILDING",
        "VALIDATING",
        "READY",
        "ACTIVE",
        "ROLLED_BACK",
        "FAILED",
        "RETIRED"
      ],
      "title": "IndexVersionStatus",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Public version facts pin the full vector/configuration space and validation reference.",
  "properties": {
    "chunking_config_version": {
      "$ref": "#/$defs/ConfigurationVersion"
    },
    "created_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "embedding": {
      "$ref": "#/$defs/EmbeddingBinding"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kb_id": {
      "format": "uuid",
      "title": "Kb Id",
      "type": "string"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentHash"
        },
        {
          "type": "null"
        }
      ]
    },
    "pipeline_version": {
      "$ref": "#/$defs/ConfigurationVersion"
    },
    "published_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/IndexVersionStatus"
    },
    "updated_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "validation_report_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Validation Report Id"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "kb_id",
    "version",
    "status",
    "embedding",
    "chunking_config_version",
    "pipeline_version",
    "manifest_sha256",
    "validation_report_id",
    "created_at",
    "updated_at",
    "published_at"
  ],
  "title": "IndexVersion",
  "type": "object"
}
