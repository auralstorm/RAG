{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Safe adapter-provided classification; uncertain external effects are never retryable.",
  "properties": {
    "code": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Code",
      "type": "string"
    },
    "message": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "outcome_unknown": {
      "title": "Outcome Unknown",
      "type": "boolean"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message",
    "retryable",
    "outcome_unknown"
  ],
  "title": "IngestionFailure",
  "type": "object"
}
