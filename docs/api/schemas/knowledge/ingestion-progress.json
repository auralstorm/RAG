{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_units": {
      "minimum": 0,
      "title": "Completed Units",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "total_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Total Units"
    }
  },
  "required": [
    "completed_units",
    "total_units"
  ],
  "title": "IngestionProgress",
  "type": "object"
}
