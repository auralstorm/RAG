        "currency",
        "source"
      ],
      "title": "ModelCost",
      "type": "object"
    },
    "UsageSource": {
      "enum": [
        "REPORTED",
        "ESTIMATED",
        "UNAVAILABLE"
      ],
      "title": "UsageSource",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
